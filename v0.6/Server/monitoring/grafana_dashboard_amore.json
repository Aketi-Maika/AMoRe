{
  "title": "AMoRe",
  "uid": "amore-v03",
  "description": "AMoRe v0.6 のカメラ・コンテナの状態・映像品質・接続数・遅延（Prometheus）とログ（Loki）。注釈は AMoRe が送る出来事（タグ amore）。",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "amore"
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "AMoRe の出来事",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "type": "tags",
          "tags": [
            "amore"
          ],
          "limit": 200,
          "matchAny": false
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "受信中のカメラ",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(amore_camera_receiving)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "不調のカメラ",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(amore_camera_problem)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OBS接続数",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(amore_camera_srt_readers)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Docker / k8s API 接続",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "接続不可",
                  "color": "red"
                },
                "1": {
                  "text": "接続中",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_docker_up"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "受信ビットレート（カメラPC→Server）",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(amore_camera_inbound_bytes[1m]) * 8",
          "legendFormat": "{{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "受信状態",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "未送信",
                  "color": "gray"
                },
                "1": {
                  "text": "受信中",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_receiving",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "コンテナの再起動回数",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_container_restarts",
          "legendFormat": "{{camera}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "不調・録画・AIの異常検知",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_problem",
          "legendFormat": "不調 {{camera}}"
        },
        {
          "refId": "B",
          "expr": "amore_camera_recording",
          "legendFormat": "録画 {{camera}}"
        },
        {
          "refId": "C",
          "expr": "amore_camera_ai_anomaly",
          "legendFormat": "AI異常 {{camera}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "最大の遅延（カメラPC → OBS）",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(amore_camera_latency_ms)"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "送信中のカメラPC（WebRTC）",
      "gridPos": {
        "x": 6,
        "y": 18,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(amore_camera_publishers)"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "映像確認・モニターの接続数",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(amore_camera_preview_viewers)"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "720p に下げているカメラ",
      "gridPos": {
        "x": 18,
        "y": 18,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(amore_camera_fallback)"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "遅延（カメラPC → OBS。最新の測定値）",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_latency_ms",
          "legendFormat": "{{name}}（{{camera}}） → {{obs}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "遅延（直近60秒の平均・最大）",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_latency_avg_ms",
          "legendFormat": "平均 {{name}}（{{camera}}） → {{obs}}"
        },
        {
          "refId": "B",
          "expr": "amore_camera_latency_max_ms",
          "legendFormat": "最大 {{name}}（{{camera}}） → {{obs}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "解像度（送信している映像の高さ）",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_video_height",
          "legendFormat": "{{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "フレームレート",
      "gridPos": {
        "x": 8,
        "y": 30,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_video_fps",
          "legendFormat": "{{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "映像ビットレート（送信画面）",
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Kbits"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_video_bitrate_kbps",
          "legendFormat": "{{name}}（{{camera}}）"
        },
        {
          "refId": "B",
          "expr": "amore_camera_available_bitrate_kbps",
          "legendFormat": "推定帯域 {{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "パケット損失率（カメラPC → Server）",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_packet_loss_percent",
          "legendFormat": "{{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "RTT・ジッター（カメラPC ⇔ Server）",
      "gridPos": {
        "x": 8,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_rtt_ms",
          "legendFormat": "RTT {{name}}（{{camera}}）"
        },
        {
          "refId": "B",
          "expr": "amore_camera_jitter_ms",
          "legendFormat": "ジッター {{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Server で失われた受信パケット（1分あたり）",
      "gridPos": {
        "x": 16,
        "y": 37,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(amore_camera_webrtc_packets_lost[1m])",
          "legendFormat": "{{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "接続数",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_publishers",
          "legendFormat": "カメラPC {{name}}（{{camera}}）"
        },
        {
          "refId": "B",
          "expr": "amore_camera_srt_readers",
          "legendFormat": "OBS {{name}}（{{camera}}）"
        },
        {
          "refId": "C",
          "expr": "amore_camera_preview_viewers",
          "legendFormat": "映像確認 {{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "OBS（SRT）の RTT・再送",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_srt_rtt_ms",
          "legendFormat": "RTT {{name}}（{{camera}}） {{remote}}"
        },
        {
          "refId": "B",
          "expr": "increase(amore_srt_packets_retrans[1m])",
          "legendFormat": "再送/分 {{name}}（{{camera}}） {{remote}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "state-timeline",
      "title": "品質低下（ブラウザが映像の品質を下げている理由・720p への切替）",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "なし",
                  "color": "green"
                },
                "1": {
                  "text": "あり",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amore_camera_quality_limited",
          "legendFormat": "{{name}}（{{camera}}） {{reason}}"
        },
        {
          "refId": "B",
          "expr": "amore_camera_fallback",
          "legendFormat": "720p {{name}}（{{camera}}）"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "出来事（追加・削除・不調・復旧・録画・AI）",
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"amore\", source=\"event\"}"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "ログ（AMoRe・カメラのコンテナ）",
      "gridPos": {
        "x": 0,
        "y": 66,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"amore\", source=~\"amore|camera\"}"
        }
      ]
    }
  ]
}
